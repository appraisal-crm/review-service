  "cards": [
    {
      "dot": "cyan",
      "title": "Движок расчёта оценки (Выделенный модуль)",
      "items": [
        "Сравнительный подход по 4 объектам-аналогам (Apartment comparative valuation)",
        "8 этапов: торг, локация/район, масштаб площади, отделка/состояние, этаж, взвешивание",
        "Динамические коэффициенты и матрицы в таблице formula_configs (управление admin)"
      ]
    },
    {
      "dot": "emerald",
      "title": "Событийная архитектура и надёжность",
      "items": [
        "Потребление request.status_changed с проверкой дедупликации в Redis (TTL)",
        "Транзакционный Outbox: гарантированная публикация report.ready в Kafka",
        "Идемпотентность создания оценки через UNIQUE(request_id) в PostgreSQL"
      ]
    },
    {
      "dot": "rose",
      "title": "Безопасность и хранение данных",
      "items": [
        "RBAC-авторизация (роли appraiser и admin) с валидацией JWKS Keycloak",
        "Заморозка агрегата оценки при статусе completed (CAS-проверка)",
        "Бинарные файлы отчётов в S3 Yandex Cloud с доступом по Presigned URL"
      ]
    }
